# ESWASA — production .htaccess
# Speed (compression + browser caching) and basic file protection.
# Every block is guarded by <IfModule> so a missing Apache module can't 500
# the site. Safe to remove any block if your host behaves differently.

# ── 1. Gzip compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/ttf font/otf font/woff font/woff2
</IfModule>

# ── 2. Browser caching ──────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # Static assets — cache long; filenames change when content changes.
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    # PDFs — moderate.
    ExpiresByType application/pdf         "access plus 1 month"
    # HTML — short, so content edits show quickly.
    ExpiresByType text/html               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # Keep connections alive for fewer round-trips.
    Header set Connection keep-alive
    # Don't cache dynamic PHP output aggressively (CMS edits must show).
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ── 3. Protect sensitive files ──────────────────────────────────────
# Block direct web access to migrations, notes, logs and includes.
<FilesMatch "\.(sql|md|log|ini|sh|ps1)$">
    Require all denied
</FilesMatch>

# Hide dotfiles (.git, .env, etc.) if any slip onto the server.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── 4. Default document ─────────────────────────────────────────────
DirectoryIndex index.php index.html
